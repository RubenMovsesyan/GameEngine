#!/bin/sh
set -e
cd "$(dirname "$0")"
if [ "$1" = clean ]; then
	rm -rf .build
	shift
fi
[ -x ./build ] || clang++ -std=c++23 build.cpp -o build
./build -j $(getconf _NPROCESSORS_ONLN)

# Optional first arg picks the sandbox (a dir under sandbox/); default is model_test.
# Anything starting with '-' is a flag for the default sandbox, not a name.
SANDBOX=model_test
case "$1" in
	-* | "") ;;
	*) SANDBOX=$1; shift ;;
esac
exec ".build/bin/sandbox/$SANDBOX" "$@"
